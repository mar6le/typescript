{
	"compilerOptions": {
		"target": "ES6",
		"module": "none",
		"lib": ["es2016", "DOM"],
		"strict": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": false
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
